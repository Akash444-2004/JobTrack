{
  "info": {
    "name": "JobTrack - Job Application Tracking System API",
    "_postman_id": "7f3f9a10-2b8a-4e2f-b658-jobtrack2026",
    "description": "Complete REST API collection for JobTrack (Java 21, Spring Boot, Spring Security + JWT, PostgreSQL 18). Register or Login automatically stores {{token}} in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "applicationId", "value": "1", "type": "string" },
    { "key": "interviewId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Akash Verma\",\n  \"email\": \"akash@jobtrack.dev\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"akash@jobtrack.dev\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Profile",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Akash Verma\",\n  \"email\": \"akash@jobtrack.dev\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Job Applications",
      "item": [
        {
          "name": "Create Job Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('applicationId', String(json.id)); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Atlassian\",\n  \"jobTitle\": \"Java Full-Stack Engineer\",\n  \"jobDescription\": \"Design and scale backend microservices with Java 21, Spring Boot, PostgreSQL, and React.\",\n  \"location\": \"Bengaluru\",\n  \"jobType\": \"FULL_TIME\",\n  \"workMode\": \"HYBRID\",\n  \"salary\": \"28 LPA\",\n  \"applicationDate\": \"2026-11-10\",\n  \"status\": \"APPLIED\",\n  \"jobUrl\": \"https://www.atlassian.com/company/careers\",\n  \"recruiterName\": \"Ananya Rao\",\n  \"recruiterEmail\": \"ananya.rao@atlassian.com\",\n  \"notes\": \"Applied via referral.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Get All Applications (Paginated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications?page=0&size=10&sortBy=applicationDate&sortDir=desc",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "applicationDate" },
                { "key": "sortDir", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Search & Filter Applications",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications/search?keyword=Atlassian&status=APPLIED&workMode=HYBRID",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "search"],
              "query": [
                { "key": "keyword", "value": "Atlassian" },
                { "key": "status", "value": "APPLIED" },
                { "key": "workMode", "value": "HYBRID" }
              ]
            }
          }
        },
        {
          "name": "Get Application By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "Update Job Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Atlassian\",\n  \"jobTitle\": \"Java Full-Stack Engineer\",\n  \"jobDescription\": \"Design and scale backend microservices with Java 21, Spring Boot, PostgreSQL, and React.\",\n  \"location\": \"Bengaluru\",\n  \"jobType\": \"FULL_TIME\",\n  \"workMode\": \"HYBRID\",\n  \"salary\": \"30 LPA\",\n  \"applicationDate\": \"2026-11-10\",\n  \"status\": \"INTERVIEW\",\n  \"jobUrl\": \"https://www.atlassian.com/company/careers\",\n  \"recruiterName\": \"Ananya Rao\",\n  \"recruiterEmail\": \"ananya.rao@atlassian.com\",\n  \"notes\": \"Moved to technical interview round.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "Delete Job Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        }
      ]
    },
