            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interviewRound\": \"System Design & Java Concurrency\",\n  \"interviewDate\": \"2026-11-18\",\n  \"interviewTime\": \"15:00:00\",\n  \"interviewerName\": \"Vikram Mehta\",\n  \"interviewNotes\": \"Strong discussion on caching and partitioning.\",\n  \"outcome\": \"PASSED\"\n}"
            },
            "url": {
